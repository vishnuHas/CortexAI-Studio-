# CortexAI Studio Environment Configuration

# NVIDIA NIM API Key (Optional for offline demo mode, required for live NVIDIA NIM)
NVIDIA_API_KEY=nvapi-your-key-here

# NVIDIA NIM Endpoint (Default OpenAI compatible API)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Preferred LLM & Embedding Models
DEFAULT_CHAT_MODEL=meta/llama-3.1-8b-instruct
DEFAULT_FAST_MODEL=meta/llama-3.1-8b-instruct
DEFAULT_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
